<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.xiaobai.scan</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/yyz/Documents/cursor/商业变现/扫描机会/run.sh</string>
    </array>
    <!-- 每天 9:30 运行；如果当时电脑在睡眠，唤醒后会补跑 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardErrorPath</key>
    <string>/Users/yyz/Documents/cursor/商业变现/扫描机会/logs/launchd.err</string>
</dict>
</plist>
